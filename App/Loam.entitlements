<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Lets the app load third-party plugins: libraries built on the user's machine (signed ad hoc), from the
         open vault's .loam/cache/plugins/. Only checked under the hardened runtime, which notarized builds need;
         the ad-hoc local build has no hardened runtime and loads them anyway. See docs/PLUGIN-LOADING.md. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Meetings and voice notes record the microphone: under the hardened runtime that needs this entitlement. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
