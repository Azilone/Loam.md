filters:
  and:
    - file.inFolder("Reading")
    - file.ext == "md"
views:
  - type: kanban
    name: Kanban
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - author
  - type: table
    name: Table
    order:
      - file.name
      - author
      - status
      - rating
  - type: cards
    name: Gallery
    order:
      - file.name
      - author
properties:
  status:
    type: select
    options:
      - To read
      - Reading
      - Finished
  rating:
    type: number
